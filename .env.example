# Sösh Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to git.

# -------------------------------------------------------------------
# Supabase
# -------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Direct DB connection (used by API for queries)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Sync connection for Supabase CLI migrations
DATABASE_URL_SYNC=postgresql://user:password@host:5432/dbname

# -------------------------------------------------------------------
# Redis
# -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Production (Fly.io internal network): redis://redis-vm:6379

# -------------------------------------------------------------------
# Cloudflare R2
# -------------------------------------------------------------------
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=                         # https://{account_id}.r2.cloudflarestorage.com
R2_BUCKET_NAME=sosh-media

# -------------------------------------------------------------------
# Expo Push Notifications
# -------------------------------------------------------------------
EXPO_ACCESS_TOKEN=

# -------------------------------------------------------------------
# App config (tunable without a code deploy)
# Defaults are baked into the API if these are not set.
# -------------------------------------------------------------------
VOTING_WINDOW_HOURS=2

# -------------------------------------------------------------------
# Phase 2 only — leave blank until features are ready to ship
# -------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
