{
  "expo": {
    "name": "Sösh",
    "slug": "sosh",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sosh",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sosh.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Sösh uses your camera to capture Pulse entries.",
        "NSMicrophoneUsageDescription": "Sösh uses your microphone to record video Pulse entries.",
        "NSLocationWhenInUseUsageDescription": "Sösh uses your location to place you in a city leaderboard."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.sosh.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#000000"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sösh uses your location to place you in a city leaderboard."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
